# TransitOS Backend — environment variables
# Copy to `.env` and fill in real values. Never commit the `.env` file.

# ─── Runtime ─────────────────────────────────────────────────────────────────
# dev | staging | prod. Controls how verbose logs are and what error bodies
# the client sees. Default: dev.
ENV=dev

# Python logging level: DEBUG, INFO, WARNING, ERROR. Default: INFO.
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string. The app accepts BOTH naming conventions:
#   - Our own:        MONGODB_URL / MONGODB_DB_NAME
#   - Railway plugin: MONGO_URL / MONGO_DB (or MONGO_URI / MONGO_DATABASE)
# For local dev:      mongodb://localhost:27017
# For Atlas:          mongodb+srv://user:pass@cluster.x.mongodb.net/
# For Railway plugin: leave MONGODB_URL blank and set MONGO_URL instead.
MONGODB_URL=mongodb://localhost:27017
# MONGO_URL=mongodb://containers-us-west-XX.railway.app:XXXXX

# Name of the Mongo database the app reads/writes.
MONGODB_DB_NAME=transitos
# MONGO_DB=railway

# ─── Security / JWT ─────────────────────────────────────────────────────────
# HS256 signing key for access + refresh tokens.
# MUST be set in any non-dev environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-please-use-a-long-random-secret-string

# JWT algorithm. Sprint A only supports HS256 (symmetric).
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes (15 per spec).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh-token lifetime in days (7 per spec).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or `*` for any. Default: *
# In production, list only your frontend domains:
#   CORS_ORIGINS=https://app.transitos.example,https://admin.transitos.example
CORS_ORIGINS=*

# ─── Admin bootstrap (one-shot seeding) ─────────────────────────────────────
# Set this to a random secret (e.g. `openssl rand -hex 32`) to enable
# POST /admin/seed. Once you've bootstrapped the Owner / GM / super_admin
# accounts, UNSET this env var to permanently disable the endpoint.
#
# To call from curl:
#   curl -X POST https://<your-api>/admin/seed \
#        -H "X-Admin-Token: <the-secret>"
#
# ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# ─── Rate limiting (optional) ────────────────────────────────────────────────
# When set, rate-limit counters are shared across workers via Redis.
# Leave unset for single-worker / local dev (in-memory backend).
# RATE_LIMIT_REDIS_URL takes precedence over REDIS_URL.
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/1
#
# When Redis is configured but unreachable the default policy is *fail-open*
# (allow the request, log a warning). Set RATE_LIMIT_FAIL_CLOSED=true to
# reject with 429 instead — preferred for high-security multi-worker deploys.
# RATE_LIMIT_FAIL_CLOSED=false
#
# ─── Request body size limit (optional) ──────────────────────────────────────
# Max Content-Length accepted by the API (bytes). Default: 1048576 (1 MiB).
# MAX_REQUEST_BODY_BYTES=1048576
