<?xml version="1.0" encoding="utf-8"?>
<!--
  The renderer's only package dependency (DocumentFormat.OpenXml) comes from
  nuget.org.

  The earlier configuration listed a single, machine-specific local folder
  (/root/.nuget/packages). That folder exists on exactly one machine, so
  `dotnet build` failed everywhere else with NU1301 — including in CI and
  on the developer's own laptop. The build step in docs/build_manual.sh
  therefore could not run at all.

  nuget.org is the source of truth for the package; a local folder can
  still be added by whoever needs an offline build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
